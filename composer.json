{
    "require": {
        "php": ">=7.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "szepeviktor/phpstan-wordpress": "^1.1",
        "php-stubs/woocommerce-stubs": "^7.4",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Shipping_Simulator\\": [
                "classes/"
            ],
            "Shipping_Simulator\\Core\\": [
                "core/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipping_Simulator\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform-check": false
    },
    "scripts": {
        "build": "./scripts/build",
        "deploy": "./scripts/svn-push",
        "update-trunk": "./scripts/svn-push --only-trunk",
        "make-pot": "wp i18n make-pot . languages/shipping-simulator-for-woocommerce.pot",
        "upgrade-core": "./scripts/upgrade-core",
        "check": "phpstan",
        "test": "phpunit"
    },
    "wp-plugin-base": {
        "namespace": "Shipping_Simulator",
        "text-domain": "shipping-simulator-for-woocommerce"
    }
}
